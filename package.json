{
  "name": "@o.z/zdi",
  "version": "0.4.0",
  "description": "A lightweight, type-safe Dependency Injection container for TypeScript/JavaScript applications.",
  "homepage": "https://github.com/z-npm/zdi#readme",
  "docs": "https://github.com/z-npm/zdi#readme",
  "bugs": {
    "url": "https://github.com/z-npm/zdi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/z-npm/zdi.git"
  },
  "author": {
    "name": "Zero Red",
    "email": "github@zero-red.dev",
    "url": "https://github.com/zero-red-dev"
  },
  "maintainers": [
    {
      "name": "Zero Red",
      "email": "github@zero-red.dev",
      "url": "https://github.com/zero-red-dev"
    }
  ],
  "license": "GPL-3.0-only",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/zero-red-dev"
  },
  "social": {
    "tiktok": "@zero.red.dev",
    "github": "zero-red-dev"
  },
  "keywords": [
    "dependency-injection",
    "di",
    "ioc",
    "container",
    "inversion-of-control",
    "typescript",
    "javascript",
    "lightweight",
    "zero-dependency"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && yarn docs",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@o.z/vite-plugin-swc": "^0.19.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "glob": "^13.0.6",
    "jsdom": "^30.0.1",
    "sass": "^1.103.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-lib-inject-css": "2.0.1",
    "vitest": "^4.1.11"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "packageManager": "yarn@4.18.0"
}
